#!/bin/sh
# Gate pre-push DURO: OCR review obligatorio antes de push a main.
# - Con TTY: prompt interactivo (S = ejecutar OCR; n u otra respuesta = aborta).
# - Sin TTY (agentes/CI): exige OCR_PUSH_CONFIRM=1; el agente debe pedir
#   permiso al usuario antes de fijarlo.
# - Si OCR falla, excede el timeout o reporta hallazgos: push ABORTADO.
# Activación: git config core.hooksPath .githooks
# Escape: git push --no-verify (omite este gate)
# Dry-run (no ejecuta OCR ni prompt): OCR_HOOK_DRY_RUN=1

zero=0000000000000000000000000000000000000000

# Endpoint del LLM local. Debe coincidir con ~/.opencodereview/config.json;
# si cambias la config, ajusta también OCR_LLM_URL.
: "${OCR_LLM_URL:=http://localhost:8081}"
: "${OCR_LLM_TOKEN:=dummy}"
: "${OCR_LLM_MODEL:=Qwen3.5-9B-Q4_K_M}"
: "${OCR_TIMEOUT:=600}"
export OCR_LLM_URL OCR_LLM_TOKEN OCR_LLM_MODEL

abort() {
  echo "pre-push: $*" >&2
  exit 1
}

# Ancla el hook a la raíz del repo: cwd estable para OCR y para review.json
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root" || abort "no puedo situarme en la raíz del repo"

# Valida el runner y la conectividad antes de invocar OCR. El wrapper `ocr`
# de npm solo resuelve rutas bajo sh MSYS (Git Bash); desde WSL/Linux se
# invoca vía interop de Windows.
runner_ok() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
      command -v ocr >/dev/null 2>&1 || abort "'ocr' no está en PATH; instala con: npm i -g @alibaba-group/open-code-review"
      ocr --version >/dev/null 2>&1 || abort "'ocr' está en PATH pero no responde (--version falló)"
      [ -x /usr/bin/timeout ] || abort "no hay /usr/bin/timeout (coreutils) para limitar la ejecución de OCR"
      command -v curl >/dev/null 2>&1 || abort "no hay 'curl' para verificar el endpoint LLM"
      ;;
    Darwin*)
      command -v ocr >/dev/null 2>&1 || abort "'ocr' no está en PATH"
      command -v timeout >/dev/null 2>&1 || abort "no hay 'timeout' para limitar OCR"
      command -v curl >/dev/null 2>&1 || abort "no hay 'curl' para verificar el endpoint LLM"
      ;;
    Linux*)
      command -v cmd.exe >/dev/null 2>&1 || abort "no hay cmd.exe (interop Windows); haz el push desde Git Bash de Windows"
      command -v timeout >/dev/null 2>&1 || abort "no hay 'timeout' para limitar la ejecución de OCR"
      command -v curl >/dev/null 2>&1 || abort "no hay 'curl' para verificar el endpoint LLM"
      cmd.exe /C where ocr.cmd >/dev/null 2>&1 || abort "'ocr.cmd' no está en el PATH de Windows; instala @alibaba-group/open-code-review global"
      cmd.exe /C ocr.cmd --version >/dev/null 2>&1 || abort "'ocr.cmd' existe pero no responde (--version falló)"
      ;;
    *)
      abort "entorno no soportado por el gate OCR ($(uname -s))"
      ;;
  esac
  # Conectividad del endpoint LLM (debe coincidir con la config de OCR)
  curl -s --max-time 10 -o /dev/null "$OCR_LLM_URL/v1/models" \
    || abort "endpoint LLM $OCR_LLM_URL no accesible; revisa el router (llama-server) o ajusta OCR_LLM_URL"
}

run_ocr_review() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) /usr/bin/timeout "$OCR_TIMEOUT" ocr review "$@" ;;
    Darwin*) timeout "$OCR_TIMEOUT" ocr review "$@" ;;
    Linux*) timeout "$OCR_TIMEOUT" cmd.exe /C ocr.cmd review "$@" ;;
  esac
}

# Evalúa review.json: exit 0 = sin hallazgos; exit 1 = abortar (cualquier
# error usa el mismo código para que el caller trate todo igual).
# Imprime cada hallazgo para que se vea el motivo del bloqueo.
judge_review_json() {
  command -v node >/dev/null 2>&1 || { echo "pre-push: 'node' no disponible; no puedo evaluar review.json" >&2; return 1; }
  node --version >/dev/null 2>&1 || { echo "pre-push: 'node' está instalado pero no funciona" >&2; return 1; }
  [ -f review.json ] || { echo "pre-push: OCR no generó review.json; push abortado" >&2; return 1; }
  node -e '
    const fs = require("fs");
    const path = process.argv[1] || "review.json";
    let st;
    try { st = fs.statSync(path); }
    catch (e) { console.error("pre-push: no puedo leer " + path + ": " + e.message); process.exit(1); }
    if (!st.isFile() || st.size === 0) { console.error("pre-push: " + path + " vacio o invalido; push abortado."); process.exit(1); }
    if (st.size > 10 * 1024 * 1024) { console.error("pre-push: " + path + " supera 10MB; push abortado."); process.exit(1); }
    let j;
    try { j = JSON.parse(fs.readFileSync(path, "utf8")); }
    catch (e) { console.error("pre-push: " + path + " no es JSON valido: " + e.message); process.exit(1); }
    if (!j || typeof j !== "object" || !j.summary) { console.error("pre-push: " + path + " sin summary; push abortado."); process.exit(1); }
    const n = j.summary.comments || 0;
    if (j.status !== "complete") { console.error("pre-push: OCR status=" + j.status + " - push abortado."); process.exit(1); }
    if (n > 0) {
      console.error("pre-push: OCR reporto " + n + " hallazgo(s) - push ABORTADO:");
      for (const c of (j.comments || [])) {
        const txt = String(c.content || "").replace(/\s+/g, " ").trim().slice(0, 220);
        console.error("  [" + (c.severity || "?") + "/" + (c.category || "?") + "] " + (c.path || "?") + " - " + txt);
      }
      console.error("  Detalle completo en " + path);
      process.exit(1);
    }
    console.error("pre-push: OCR sin hallazgos - push permitido.");
    process.exit(0);
  ' review.json || return 1
}

# Solo actúa si algún ref remoto destino es refs/heads/main
gate=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) gate=1; to_sha="$local_sha"; from_sha="$remote_sha" ;;
  esac
done

[ "$gate" -eq 1 ] || exit 0

# Borrado de main o primer push sin ref base: no hay rango que revisar
if [ "$to_sha" = "$zero" ]; then
  echo "pre-push: borrado de main; gate OCR omitido." >&2
  exit 0
fi
if [ "$from_sha" = "$zero" ]; then
  echo "pre-push: primer push a main (sin base remota); gate OCR omitido." >&2
  exit 0
fi

if [ "${OCR_HOOK_DRY_RUN:-0}" = "1" ]; then
  echo "pre-push [dry-run]: OCR review --from $from_sha --to $to_sha (modelo $OCR_LLM_MODEL)"
  exit 0
fi

runner_ok

# Confirmación del uso de OCR (gate duro: solo S explícito ejecuta)
answer=""
if { printf 'Push a main (gate duro): ejecutar OCR review del rango a subir? [S/n] ' && read answer; } < /dev/tty > /dev/tty 2>/dev/null; then
  case "$answer" in
    s*|S*|y*|Y*) : ;;
    n*|N*) abort "revision OCR obligatoria para push a main (respondiste '$answer'); usa --no-verify para forzar." ;;
    *) abort "respuesta vacia o no reconocida ('$answer'): responde S (ejecutar) o n (forzar luego con --no-verify)." ;;
  esac
elif [ "${OCR_PUSH_CONFIRM:-0}" != "1" ]; then
  abort "sin terminal y sin OCR_PUSH_CONFIRM=1. Para agentes: pide confirmacion al usuario y exporta OCR_PUSH_CONFIRM=1; o ejecuta el push desde un terminal interactivo."
fi

echo "pre-push: ejecutando OCR review ($from_sha..$to_sha) con $OCR_LLM_MODEL (timeout ${OCR_TIMEOUT}s)..." >&2
if run_ocr_review --from "$from_sha" --to "$to_sha" --format json --output review.json; then
  :
else
  ocr_status=$?
  abort "OCR fallo (codigo $ocr_status; 124 = timeout de ${OCR_TIMEOUT}s) - push a main bloqueado. Detalles en review.json; escape: --no-verify."
fi

if judge_review_json; then
  :
else
  judge_status=$?
  abort "revision OCR con hallazgos o errores (codigo $judge_status) - push a main bloqueado."
fi
