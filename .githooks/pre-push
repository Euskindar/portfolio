#!/bin/sh
# Gate pre-push DURO: OCR review obligatorio antes de push a main.
# - Con TTY: prompt interactivo (S = ejecutar OCR; n = aborta el push).
# - Sin TTY (agentes/CI): exige OCR_PUSH_CONFIRM=1 en el entorno; el agente
#   debe pedir permiso al usuario antes de fijarlo.
# - Si OCR falla o reporta hallazgos: push ABORTADO con el detalle.
# Activación: git config core.hooksPath .githooks
# Escape: git push --no-verify (omite este gate)
# Dry-run (no ejecuta OCR ni prompt): OCR_HOOK_DRY_RUN=1

zero=0000000000000000000000000000000000000000

# Endpoint del LLM local (override con variables de entorno si cambia).
# La configuración persistente vive en ~/.opencodereview/config.json (Windows).
: "${OCR_LLM_URL:=http://localhost:8081}"
: "${OCR_LLM_TOKEN:=dummy}"
: "${OCR_LLM_MODEL:=Qwen3.5-9B-Q4_K_M}"
export OCR_LLM_URL OCR_LLM_TOKEN OCR_LLM_MODEL

abort() {
  echo "pre-push: $*" >&2
  exit 1
}

# Valida que el runner de OCR exista antes de invocarlo. El wrapper `ocr`
# de npm solo resuelve rutas bajo sh MSYS (Git Bash); desde WSL/Linux se
# invoca vía interop de Windows.
runner_ok() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*|Darwin*)
      command -v ocr >/dev/null 2>&1 || abort "'ocr' no está en PATH; instala con: npm i -g @alibaba-group/open-code-review"
      ;;
    Linux*)
      command -v cmd.exe >/dev/null 2>&1 || abort "no hay cmd.exe (interop Windows) para invocar OCR; haz el push desde Git Bash de Windows"
      cmd.exe /C where ocr.cmd >/dev/null 2>&1 || abort "'ocr.cmd' no está disponible en el PATH de Windows; instala @alibaba-group/open-code-review global"
      ;;
    *)
      abort "entorno no soportado por el gate OCR ($(uname -s))"
      ;;
  esac
}

run_ocr_review() {
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*|Darwin*) ocr review "$@" ;;
    Linux*) cmd.exe /C ocr.cmd review "$@" ;;
  esac
}

# Evalúa review.json: exit 0 = sin hallazgos; exit 1 = abortar.
# Imprime cada hallazgo para que se vea el motivo del bloqueo.
judge_review_json() {
  command -v node >/dev/null 2>&1 || { echo "pre-push: 'node' no disponible; no puedo evaluar review.json" >&2; return 1; }
  node -e '
    const fs = require("fs");
    let j;
    try { j = JSON.parse(fs.readFileSync("review.json", "utf8")); }
    catch (e) { console.error("pre-push: review.json ilegible: " + e.message); process.exit(2); }
    const n = (j.summary && j.summary.comments) || 0;
    if (j.status !== "complete") {
      console.error("pre-push: OCR termino con status=" + j.status + " - push abortado.");
      process.exit(1);
    }
    if (n > 0) {
      console.error("pre-push: OCR reporto " + n + " hallazgo(s) - push ABORTADO:");
      for (const c of (j.comments || [])) {
        const txt = String(c.content || "").replace(/\s+/g, " ").trim().slice(0, 220);
        console.error("  [" + (c.severity || "?") + "/" + (c.category || "?") + "] " + (c.path || "?") + " - " + txt);
      }
      console.error("  Detalle completo en review.json");
      process.exit(1);
    }
    console.error("pre-push: OCR sin hallazgos - push permitido.");
    process.exit(0);
  ' || return 1
}

# Solo actúa si algún ref remoto destino es refs/heads/main
gate=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) gate=1; to_sha="$local_sha"; from_sha="$remote_sha" ;;
  esac
done

[ "$gate" -eq 1 ] || exit 0

# Borrado de main o primer push sin ref base: no hay rango que revisar
if [ "$to_sha" = "$zero" ]; then
  echo "pre-push: borrado de main; gate OCR omitido." >&2
  exit 0
fi
if [ "$from_sha" = "$zero" ]; then
  echo "pre-push: primer push a main (sin base remota); gate OCR omitido." >&2
  exit 0
fi

if [ "${OCR_HOOK_DRY_RUN:-0}" = "1" ]; then
  echo "pre-push [dry-run]: OCR review --from $from_sha --to $to_sha (modelo $OCR_LLM_MODEL)"
  exit 0
fi

runner_ok

# Confirmación del uso de OCR (gate duro: rechazar = abortar el push)
answer=""
if { printf 'Push a main (gate duro): ejecutar OCR review del rango a subir? [S/n] ' && read answer; } < /dev/tty > /dev/tty 2>/dev/null; then
  case "$answer" in
    n*|N*) abort "revision OCR obligatoria para push a main (respondiste '$answer'); usa --no-verify para forzar." ;;
  esac
elif [ "${OCR_PUSH_CONFIRM:-0}" != "1" ]; then
  abort "sin terminal para el prompt y sin OCR_PUSH_CONFIRM=1: falta confirmar el uso de OCR."
fi

echo "pre-push: ejecutando OCR review ($from_sha..$to_sha) con $OCR_LLM_MODEL..." >&2
run_ocr_review --from "$from_sha" --to "$to_sha" --format json --output review.json \
  || abort "OCR fallo (codigo $?) - push a main bloqueado. Revisa review.json o usa --no-verify."

judge_review_json || abort "revision OCR con hallazgos o errores - push a main bloqueado."

exit 0
